      "id": "file:style/queries/condition.rs",
      "type": "file",
      "name": "condition.rs",
      "filePath": "style/queries/condition.rs",
      "summary": "Implements query condition parsing and evaluation for CSS media and container queries, including style queries, boolean operations (And/Or/Not), custom -moz-pref() features, and GeneralEnclosed fallback with var()-substitution re-parsing.",
      "tags": ["media-queries", "container-queries", "css-parser", "condition-evaluation"],
      "complexity": "complex",
      "languageNotes": "Uses Kleene 3-valued logic (True/False/Unknown) for query evaluation, and OperationParser trait for shared boolean-combinator parsing between media and container queries."
    },
