      "id": "file:to_shmem/lib.rs",
      "type": "file",
      "name": "lib.rs",
      "filePath": "to_shmem/lib.rs",
      "summary": "Provides the SharedMemoryBuilder type and ToShmem trait for cloning data into a contiguous shared memory buffer, with implementations for standard library types and feature-gated support for servo_arc, smallvec, thin-vec, smallbitvec, string_cache, and cssparser types.",
      "tags": ["shared-memory", "trait", "unsafe", "serialization"],
      "complexity": "complex",
      "languageNotes": "Extensive use of unsafe pointer arithmetic, ManuallyDrop, and custom Layout-based allocation to ensure zero-copy semantics when writing into a pre-allocated shared memory buffer. Trait impls are feature-gated for Servo/Gecko build configurations."
    },
