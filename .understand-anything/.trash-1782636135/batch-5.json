{
  "nodes": [
    {
      "id": "file:style/stylist.rs",
      "type": "file",
      "name": "stylist.rs",
      "filePath": "style/stylist.rs",
      "summary": "Core CSS selector matching and style computation engine for Servo/Gecko. Manages stylesheets across origins (user-agent, user, author), maintains cascade data structures with invalidation maps and rule trees, and provides the primary API for pushing applicable declarations and resolving computed styles for elements and pseudo-elements.",
      "tags": ["rust", "style-engine", "selector-matching", "cascade", "data-model"],
      "complexity": "complex",
      "languageNotes": "Rust implementation using Servo's selectors crate for CSS selector matching. Employs generics with TElement trait for cross-engine (Servo/Gecko) compatibility. Uses reference-counted Arcs and shared locks for thread-safe stylesheet management."
    },
    {
      "id": "class:style/stylist.rs:Stylist",
      "type": "class",
      "name": "Stylist",
      "filePath": "style/stylist.rs",
      "lineRange": [599, 649],
      "summary": "Central struct holding all selectors and device characteristics for a document. Owns stylesheets, rule tree, cascade data per origin, custom property registrations, and the computation device. Created once per pipeline and rebuilt when stylesheets or device constraints change.",
      "tags": ["data-model", "singleton", "engine"],
      "complexity": "complex"
    },
    {
      "id": "class:style/stylist.rs:CascadeData",
      "type": "class",
      "name": "CascadeData",
      "filePath": "style/stylist.rs",
      "lineRange": [3256, 3383],
      "summary": "Per-origin cascade data containing selector maps, invalidation maps, animations, custom property registrations, container/scope conditions, and extra style data (@font-face, @counter-style, etc.). Built during stylesheet processing and used for efficient selector matching and cache invalidation.",
      "tags": ["data-model", "cache", "selector-map", "invalidation"],
      "complexity": "complex"
    },
    {
      "id": "class:style/stylist.rs:DocumentCascadeData",
      "type": "class",
      "name": "DocumentCascadeData",
      "filePath": "style/stylist.rs",
      "lineRange": [432, 438],
      "summary": "Aggregates CascadeData for all three origins (user-agent, user, author) into a single document-level structure. Provides origin-iterators and rebuild orchestration during stylesheet flushing.",
      "tags": ["data-model", "aggregator", "cascade"],
      "complexity": "moderate"
    },
    {
      "id": "class:style/stylist.rs:ExtraStyleData",
      "type": "class",
      "name": "ExtraStyleData",
      "filePath": "style/stylist.rs",
      "lineRange": [2353, 2374],
      "summary": "Holds effective at-rule style data extracted from stylesheets: @font-face, @font-feature-values, @font-palette-values, @counter-style, @position-try, @page, and @view-transition rules. All entries are layer-ordered for correct cascade resolution.",
      "tags": ["data-model", "at-rules", "font-face", "page-rules"],
      "complexity": "moderate"
    },
    {
      "id": "class:style/stylist.rs:PageRuleMap",
      "type": "class",
      "name": "PageRuleMap",
      "filePath": "style/stylist.rs",
      "lineRange": [2261, 2264],
      "summary": "Stores and matches @page rules indexed by page name. Provides matching logic that considers page-name selectors and pseudo-class flags to find applicable page rules in layer order.",
      "tags": ["data-model", "page-rules", "selector-matching"],
      "complexity": "moderate"
    },
    {
      "id": "class:style/stylist.rs:Rule",
      "type": "class",
      "name": "Rule",
      "filePath": "style/stylist.rs",
      "lineRange": [4864, 4895],
      "summary": "Individual CSS style rule with selector, hashes, style source, source order, layer/container/scope condition IDs, and cascade flags. Wraps a selector with its precomputed ancestor hashes and references to its declaration block.",
      "tags": ["data-model", "css-rule", "selector"],
      "complexity": "simple"
    },
    {
      "id": "class:style/stylist.rs:CascadeDataDifference",
      "type": "class",
      "name": "CascadeDataDifference",
      "filePath": "style/stylist.rs",
      "lineRange": [132, 135],
      "summary": "Tracks what changed between cascade data rebuilds, currently focused on changed @position-try rule names. Used to minimize invalidation work after stylesheet updates.",
      "tags": ["data-model", "diff", "invalidation"],
      "complexity": "simple"
    },
    {
      "id": "class:style/stylist.rs:LayerOrderedVec",
      "type": "class",
      "name": "LayerOrderedVec",
      "filePath": "style/stylist.rs",
      "lineRange": [2169, 2169],
      "summary": "Generic vector wrapper for items that must be sorted in @layer cascade order. Each entry pairs a value with its LayerId for deferred sorting after layer resolution.",
      "tags": ["data-model", "layer", "sorting"],
      "complexity": "simple"
    },
    {
      "id": "class:style/stylist.rs:LayerOrderedMap",
      "type": "class",
      "name": "LayerOrderedMap",
      "filePath": "style/stylist.rs",
      "lineRange": [2178, 2178],
      "summary": "Generic hash map wrapper storing layer-ordered values per key. Maps Atom keys to small vectors of (value, LayerId) pairs, sorted by layer order during cascade data finalization.",
      "tags": ["data-model", "layer", "hash-map"],
      "complexity": "moderate"
    },
    {
