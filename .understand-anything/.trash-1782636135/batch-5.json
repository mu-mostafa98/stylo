      "name": "push_applicable_declarations",
      "filePath": "style/stylist.rs",
      "lineRange": [1705, 1743],
      "summary": "Main entry point for collecting applicable CSS declarations for an element. Iterates through implemented pseudo-elements and delegates to RuleCollector for selector matching across all origins.",
      "tags": ["entry-point", "selector-matching", "core"],
      "complexity": "moderate"
    },
    {
      "id": "function:style/stylist.rs:cascade_style_and_visited",
      "type": "function",
      "name": "cascade_style_and_visited",
      "filePath": "style/stylist.rs",
      "lineRange": [1476, 1533],
      "summary": "Computes the final style (and visited-link style) for an element or pseudo-element given cascade inputs. Handles parent style inheritance, :visited rules, and delegates to properties::cascade for property resolution.",
      "tags": ["style-computation", "cascade", "visited"],
      "complexity": "moderate"
    },
    {
      "id": "function:style/stylist.rs:register_custom_property",
      "type": "function",
      "name": "register_custom_property",
      "filePath": "style/stylist.rs",
      "lineRange": [2090, 2164],
      "summary": "Implements CSS.registerProperty() per the CSS Properties and Values API specification. Validates property name, syntax descriptor, inherits flag, and initial value before registering the property in the script registry.",
      "tags": ["api", "css-houdini", "validation", "registration"],
      "complexity": "moderate"
    },
    {
      "id": "function:style/stylist.rs:match_revalidation_selectors",
      "type": "function",
      "name": "match_revalidation_selectors",
      "filePath": "style/stylist.rs",
      "lineRange": [1869, 1939],
      "summary": "Matches an element against cache revalidation selectors across all applicable cascade data (including shadow DOM). Returns a RevalidationResult with matched selectors and relevant attributes for style cache comparison.",
      "tags": ["cache", "revalidation", "selector-matching"],
      "complexity": "complex"
    },
    {
      "id": "function:style/stylist.rs:rebuild_initial_values_for_custom_properties",
      "type": "function",
      "name": "rebuild_initial_values_for_custom_properties",
      "filePath": "style/stylist.rs",
      "lineRange": [926, 969],
      "summary": "Recomputes the initial values for all registered custom properties (both script-registered and stylesheet-registered). Uses a computed context to evaluate each property's initial value, tracking seen names to handle priority.",
      "tags": ["rebuild", "custom-properties", "initial-values"],
      "complexity": "moderate"
    },
    {
      "id": "function:style/stylist.rs:rebuild_author_data",
