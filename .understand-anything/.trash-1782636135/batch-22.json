      "id": "file:style/typed_om/mod.rs",
      "type": "file",
      "name": "mod.rs",
      "filePath": "style/typed_om/mod.rs",
      "summary": "Main module for the CSS Typed OM implementation providing property-agnostic value representations including numeric values, transform components, and the ToTyped reification trait, following the CSS Typed OM Level 1 specification.",
      "tags": ["typed-om", "css-values", "type-definition", "reification", "data-model"],
      "complexity": "complex",
      "languageNotes": "Uses repr(C) for FFI compatibility with Gecko/Servo. ThinVec used for space-efficient inline storage. Derived trait implementations for Clone and Debug on all types."
    },
